# Copy this file to .env for LOCAL development only.
# On Render, set these as real Environment Variables in the dashboard —
# never commit an actual .env file with real secrets.

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_SITE_NAME=Persona Twin
OPENROUTER_MAX_TOKENS=500
OPENROUTER_TEMPERATURE=0.7

# Qdrant
QDRANT_URL=https://REPLACE_ME.aws.cloud.qdrant.io
QDRANT_API_KEY=REPLACE_ME

# Neo4j
NEO4J_URI=neo4j+s://REPLACE_ME.databases.neo4j.io
NEO4J_USER=REPLACE_ME
NEO4J_PASSWORD=REPLACE_ME

# Persona
PERSONA_NAME=Your Name
PERSONA_BIO=A short description of the persona.

# CORS: comma-separated list of allowed frontend origins in production,
# e.g. https://your-app.vercel.app . Leave unset to allow all origins.
ALLOWED_ORIGINS=

# Optional: only needed if you use the Twitter/X or Instagram scraping
# features. Use FRESH credentials — never reuse ones that were ever
# committed to git or pasted anywhere. Instagram credentials in particular
# grant near-full account access, so treat them like a password.
INSTAGRAM_USERNAME=
INSTAGRAM_SESSION_FILE=instagram_session
INSTAGRAM_REQUEST_DELAY=1.5
INSTAGRAM_SESSIONID=
INSTAGRAM_CSRFTOKEN=
INSTAGRAM_DS_USER_ID=
X_AUTH_TOKEN=
X_CT0=
